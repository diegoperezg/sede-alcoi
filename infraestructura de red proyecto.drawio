        <mxCell id="J8YXoTsCnhbxt71xB_hn-183" parent="J8YXoTsCnhbxt71xB_hn-93" style="text;whiteSpace=wrap;html=1;" value="&lt;p data-start=&quot;323&quot; data-end=&quot;451&quot;&gt;🔴&amp;nbsp;&amp;nbsp;&lt;strong data-start=&quot;326&quot; data-end=&quot;342&quot;&gt;NUCLI (Core)&lt;/strong&gt;&lt;br data-start=&quot;342&quot; data-end=&quot;345&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Equipament central de xarxa: router + switch principal. Gestiona el trànsit global, NAT, DHCP i seguretat.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;323&quot; data-end=&quot;451&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;453&quot; data-end=&quot;606&quot;&gt;🟢&amp;nbsp;&amp;nbsp;&lt;strong data-start=&quot;456&quot; data-end=&quot;500&quot;&gt;DISTRIBUCIÓ — Switch d’accés per edifici&lt;/strong&gt;&lt;br data-start=&quot;500&quot; data-end=&quot;503&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Switches que distribueixen la xarxa cap als diferents dispositius finals dins de cada edifici o planta.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;453&quot; data-end=&quot;606&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;608&quot; data-end=&quot;714&quot;&gt;🟡 &lt;strong data-start=&quot;611&quot; data-end=&quot;631&quot;&gt;&amp;nbsp; Patch Panel (PP)&lt;/strong&gt;&lt;br data-start=&quot;631&quot; data-end=&quot;634&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Punt d’interconnexió passiu per organitzar i distribuir el cablejat estructurat.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;608&quot; data-end=&quot;714&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;716&quot; data-end=&quot;819&quot;&gt;🟤&amp;nbsp;&amp;nbsp;&lt;strong data-start=&quot;719&quot; data-end=&quot;727&quot;&gt;RACK&lt;/strong&gt;&lt;br data-start=&quot;727&quot; data-end=&quot;730&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Armari físic on s’allotgen els equips de xarxa (switches, servidors, patch panels, etc.).&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;716&quot; data-end=&quot;819&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;821&quot; data-end=&quot;912&quot;&gt;⚫&amp;nbsp;&amp;nbsp;&lt;strong data-start=&quot;823&quot; data-end=&quot;845&quot;&gt;Dispositius finals&lt;/strong&gt;&lt;br data-start=&quot;845&quot; data-end=&quot;848&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Equips d’usuari: PCs, telèfons IP, impressores, càmeres IP, etc.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;821&quot; data-end=&quot;912&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;914&quot; data-end=&quot;1006&quot;&gt;🟣&amp;nbsp;&amp;nbsp;&lt;strong data-start=&quot;917&quot; data-end=&quot;947&quot;&gt;Servidors / Virtualització&lt;/strong&gt;&lt;br data-start=&quot;947&quot; data-end=&quot;950&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Infraestructura de servidors físics i màquines virtuals.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;914&quot; data-end=&quot;1006&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1008&quot; data-end=&quot;1090&quot;&gt;🟧 &lt;strong data-start=&quot;1011&quot; data-end=&quot;1039&quot;&gt;&amp;nbsp;Emmagatzematge (SAN/NAS)&lt;/strong&gt;&lt;br data-start=&quot;1039&quot; data-end=&quot;1042&quot;&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Sistemes d’emmagatzematge centralitzat de dades.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1008&quot; data-end=&quot;1090&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1092&quot; data-end=&quot;1171&quot;&gt;⚡&amp;nbsp;&a